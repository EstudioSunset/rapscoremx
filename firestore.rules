rules_version = '2';

// Reglas de seguridad de RapScore MX
// Pégalas en Firebase Console → Firestore Database → Reglas → Publicar.
//
// Colecciones:
//   users/{uid}                 perfil básico (solo el dueño)
//   ratings/{uid}_{slug}        calificación de un usuario a un artista (6 categorías, 1–100)
//   artistStats/{slug}          suma y conteo de calificaciones por artista (lectura pública)
//   proposals/{id}              artistas propuestos por estado (lectura pública)
//   contributors/{uid}          puntos y nombre público de cada contribuyente (lectura pública)
//   limits/{uid}                control anti-spam de propuestas (1 cada 10 min)
//   admins/{uid}                administradores (se crean a mano en la consola; nadie puede escribirlos desde el sitio)
//   banned/{uid}                cuentas bloqueadas por el admin (ya no pueden votar ni proponer; lectura pública para ocultarlas del ranking de contribuyentes)
//
// Las propuestas quedan en "pending" y solo se publican cuando un admin las aprueba.
//
// IMPORTANTE: al agregar artistas nuevos al ranking, agrega su slug a knownArtists().
//
// Para votar o proponer se requiere cuenta con correo verificado, que no sea de un servicio de correos
// desechables (lista en disposableEmail(); la misma lista está en index.html → DISPOSABLE_DOMAINS) y que no esté bloqueada.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function disposableEmail() {
      return request.auth.token.get('email', '').lower().matches('.*@([a-z0-9-]+\\.)*(mailinator\\.com|guerrillamail\\.com|guerrillamail\\.net|guerrillamail\\.org|sharklasers\\.com|grr\\.la|10minutemail\\.com|10minutemail\\.net|temp-mail\\.org|temp-mail\\.io|tempmail\\.com|tempmail\\.net|tempmailo\\.com|tempmail\\.plus|yopmail\\.com|yopmail\\.net|yopmail\\.fr|trashmail\\.com|trashmail\\.de|getnada\\.com|nada\\.email|dispostable\\.com|maildrop\\.cc|mailnesia\\.com|mintemail\\.com|mohmal\\.com|throwawaymail\\.com|fakeinbox\\.com|emailondeck\\.com|mailcatch\\.com|mytemp\\.email|tempr\\.email|discard\\.email|spamgourmet\\.com|burnermail\\.io|1secmail\\.com|1secmail\\.net|1secmail\\.org|mail\\.tm|mail\\.gw|moakt\\.com|tmpmail\\.org|tmpmail\\.net|tmail\\.ws|inboxkitten\\.com|mailpoof\\.com|emailfake\\.com|generator\\.email|fakemail\\.net|tempinbox\\.com|spambox\\.us|luxusmail\\.org|emltmp\\.com|cyclesat\\.com)$');
    }
    function banned() { return exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }
    function verified() { return signedIn() && request.auth.token.email_verified == true && !disposableEmail() && !banned(); }
    function isAdmin() { return verified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function limitDoc(uid) { return /databases/$(database)/documents/limits/$(uid); }

    function cats() { return ['flow', 'lirica', 'contenido', 'versatilidad', 'hooks', 'impacto']; }
    function validScore(v) { return v is int && v >= 1 && v <= 100; }
    function validScores(s) {
      return s is map && s.keys().hasAll(cats()) && s.keys().hasOnly(cats())
        && validScore(s.flow) && validScore(s.lirica) && validScore(s.contenido)
        && validScore(s.versatilidad) && validScore(s.hooks) && validScore(s.impacto);
    }
    function validSlug(slug) { return slug is string && slug.matches('^[a-z0-9][a-z0-9-]{0,79}$'); }

    // Slugs de los artistas del ranking nacional (slugify del nombre en index.html)
    function knownArtists() {
      return [
      'santa-fe-klan', 'aleman', 'gera-mx', 'c-kan', 'dharius', 'babo', 'millonario', 'mc-davo',
      'lefty-sm', 'toser-one', 'neto-pena', 'charles-ans', 'simpson-ahuevo', 'eptos-uno',
      'robot95', 'fntxy', 'sabino', 'lng-sht', 'adan-cruz', 'yoga-fire', 'serko-fu', 'bocafloja',
      'akil-ammar', 'fermin-iv', 'pato-machete', 'control-machete', 'nina-dioz', 'hispana',
      'yoss-bones', 'mare-advertencia-lirika', 'audry-funk', 'ximbo', 'muelas-de-gallo',
      'tino-el-pinguino', 'hadrian', 'danger-ak', 't-killa', 'bipo-montana', 'sick-morrison',
      'mike-diaz', 'smoky', 'zimple', 'maniako', 'cartel-de-santa', 'la-santa-grifa', 'aczino',
      'rapder', 'santa-rm', 'remik-gonzalez', 'under-side-821', 'neto-reyno', 'adan-zapata',
      'kodigo-36', 'go-golden-junk', 'chato-473',
      'eric-el-nino', 'mc-luka', 'w-corona', 'perro-zw', 'lirika-inverza', 'akwid', 'kinto-sol',
      'tren-lokote', 'geassassin', 'teeam-revolver', 'tiro-loko', 'doble-one-flow-letal', 'eanz',
      // 11 oct 2026
      'union-fatal', 'juancauf', 'soor-uefe', 'solo-cadaver', 'isek', 'thr-cru2', 'danny-brasco',
      'tankeone', 'churro-one', 'el-pinche-brujo', 'slow-flavor', 'dsmxnd', 'metrik-vader',
      'senor-marrano', 'mack-liricks', 'racal-tresvecestres', 'primero-company', 'bizor',
      'tumba2-rr', 'manoso-fast', 'sucia-elegancia',
      'faruz-feet', 'mc-aese', 'big-metra', 'el-pinche-mara', 'mr-yosie-locote', 'tornillo', 'iluminatik', 'jauria-santa',
      'bory-rvh', 'frecuencia-callejera-3', 'aryez', 'dayner-mc', 'republica-antigua'
      ];
    }
    function proposalDoc(id) { return /databases/$(database)/documents/proposals/$(id); }
    function contribDoc(uid) { return /databases/$(database)/documents/contributors/$(uid); }
    function knownSlug(slug) {
      return slug in knownArtists()
        || (slug.matches('^prop-[a-z0-9-]+$') && get(proposalDoc(slug.replace('^prop-', ''))).data.status == 'approved');
    }

    function statsDoc(slug) { return /databases/$(database)/documents/artistStats/$(slug); }
    function ratingDoc(uid, slug) { return /databases/$(database)/documents/ratings/$(uid + '_' + slug); }

    // La suma de cada categoría en artistStats debe cambiar exactamente por (nuevo − anterior)
    function sumOk(after, before, s, old, c) {
      return after[c] is int && after[c] == before.get(c, 0) + s[c] - (old == null ? 0 : old[c]);
    }
    function statsConsistent(slug, s, old) {
      let after = getAfter(statsDoc(slug)).data;
      let before = exists(statsDoc(slug)) ? get(statsDoc(slug)).data : {'count': 0, 'sum': {}};
      return after.count == before.count + (old == null ? 1 : 0)
        && after.sum.keys().hasOnly(cats())
        && sumOk(after.sum, before.sum, s, old, 'flow')
        && sumOk(after.sum, before.sum, s, old, 'lirica')
        && sumOk(after.sum, before.sum, s, old, 'contenido')
        && sumOk(after.sum, before.sum, s, old, 'versatilidad')
        && sumOk(after.sum, before.sum, s, old, 'hooks')
        && sumOk(after.sum, before.sum, s, old, 'impacto');
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /ratings/{rid} {
      allow get: if signedIn() && rid.matches(request.auth.uid + '_.+');
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      // El admin revisa todas las calificaciones (panel "Votos sospechosos")
      allow get, list: if isAdmin();
      // El admin anula una calificación: se borra en la misma transacción que resta sus valores de artistStats
      allow delete: if isAdmin() && getAfter(statsDoc(resource.data.artistSlug)).data.get('lastVoid', '') == rid;
      allow create, update: if verified()
        && validSlug(request.resource.data.artistSlug)
        && knownSlug(request.resource.data.artistSlug)
        && rid == request.auth.uid + '_' + request.resource.data.artistSlug
        && request.resource.data.keys().hasOnly(['uid', 'artistSlug', 'artist', 'scores', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.artist is string
        && request.resource.data.artist.size() > 0 && request.resource.data.artist.size() <= 80
        && request.resource.data.updatedAt == request.time
        && validScores(request.resource.data.scores)
        && statsConsistent(request.resource.data.artistSlug, request.resource.data.scores,
                           resource == null ? null : resource.data.scores);
    }

    match /artistStats/{slug} {
      allow read: if true;
      // Solo se puede escribir junto con la calificación del propio usuario (misma transacción);
      // la regla de ratings valida que la suma y el conteo cuadren.
      allow create, update: if verified()
        && validSlug(slug)
        && request.resource.data.keys().hasOnly(['count', 'sum', 'updatedAt'])
        && request.resource.data.count is int && request.resource.data.count >= 1
        && request.resource.data.updatedAt == request.time
        && getAfter(ratingDoc(request.auth.uid, slug)).data.updatedAt == request.time;
      // Anulación por el admin: resta exactamente la calificación que se está borrando (lastVoid = id de esa calificación)
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['count', 'sum', 'updatedAt', 'lastVoid'])
        && request.resource.data.updatedAt == request.time
        && voidOk(slug, request.resource.data.lastVoid);
      allow delete: if false;
    }

    function subOk(after, before, s, c) { return after[c] is int && after[c] == before.get(c, 0) - s[c]; }
    function voidOk(slug, rid) {
      let r = get(/databases/$(database)/documents/ratings/$(rid)).data;
      let after = request.resource.data;
      let before = resource.data;
      return rid is string && r.artistSlug == slug
        && !existsAfter(/databases/$(database)/documents/ratings/$(rid))
        && after.count is int && after.count == before.count - 1
        && after.sum.keys().hasOnly(cats())
        && subOk(after.sum, before.sum, r.scores, 'flow') && subOk(after.sum, before.sum, r.scores, 'lirica')
        && subOk(after.sum, before.sum, r.scores, 'contenido') && subOk(after.sum, before.sum, r.scores, 'versatilidad')
        && subOk(after.sum, before.sum, r.scores, 'hooks') && subOk(after.sum, before.sum, r.scores, 'impacto');
    }

    function proposalFieldsOk(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.genre is string && d.genre.size() <= 60
        && d.link is string && d.link.size() <= 300 && d.link.matches('^https://[^\\s]+$')
        && d.bio is string && d.bio.size() <= 280;
    }

    match /proposals/{id} {
      // Públicas solo las aprobadas; quien la propuso ve las suyas; el admin ve todas.
      allow get, list: if resource.data.status == 'approved'
        || (signedIn() && resource.data.createdBy == request.auth.uid)
        || isAdmin();
      allow create: if verified()
        && id.matches('^[a-z]{3}-[a-z0-9][a-z0-9-]{0,66}$')
        && id.split('-')[0] == request.resource.data.estado.lower()
        && request.resource.data.keys().hasOnly(['name', 'estado', 'genre', 'link', 'bio', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.estado is string && request.resource.data.estado.matches('^[A-Z]{3}$')
        && proposalFieldsOk(request.resource.data)
        // anti-spam: 1 propuesta cada 10 minutos por cuenta
        && getAfter(limitDoc(request.auth.uid)).data.lastProposalAt == request.time
        && (!exists(limitDoc(request.auth.uid))
            || request.time > get(limitDoc(request.auth.uid)).data.lastProposalAt + duration.value(10, 'm'));
      // Solo el admin aprueba, rechaza o corrige datos
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'estado', 'genre', 'link', 'bio', 'status', 'createdBy', 'createdAt', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status != 'approved' || proposalFieldsOk(request.resource.data));
      allow delete: if isAdmin();
    }

    match /limits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastProposalAt'])
        && request.resource.data.lastProposalAt == request.time;
      allow delete: if false;
    }

    match /banned/{uid} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['reason', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 120;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Contribuyentes: puntos = calificaciones × 10 + propuestas aprobadas × 20 ──
    function validName(n) { return n is string && n.matches('^[A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ ._-]{3,24}$'); }
    function sameOpt(after, before, k) { return after.get(k, null) == before.get(k, null); }
    function contribOk(uid, before, after) {
      return after.keys().hasOnly(['name', 'points', 'ratings', 'proposals', 'lastSlug', 'lastProposal', 'lastProposalAt', 'updatedAt'])
        && validName(after.name)
        && after.ratings is int && after.proposals is int && after.points is int
        && after.points == after.ratings * 10 + after.proposals * 20
        && after.updatedAt == request.time
        && (
          // el usuario solo cambia su nombre
          (request.auth.uid == uid
            && after.ratings == before.ratings && after.proposals == before.proposals
            && sameOpt(after, before, 'lastSlug') && sameOpt(after, before, 'lastProposal')
            && sameOpt(after, before, 'lastProposalAt'))
          // el usuario califica a un artista por primera vez (en esta misma escritura)
          || (request.auth.uid == uid
            && after.ratings == before.ratings + 1 && after.proposals == before.proposals
            && sameOpt(after, before, 'lastProposal') && sameOpt(after, before, 'lastProposalAt')
            && validSlug(after.lastSlug)
            && !exists(ratingDoc(uid, after.lastSlug))
            && getAfter(ratingDoc(uid, after.lastSlug)).data.updatedAt == request.time)
          // el admin aprueba una propuesta de este usuario: +20 pts una sola vez
          || (isAdmin()
            && after.proposals == before.proposals + 1 && after.ratings == before.ratings
            && after.name == before.get('name', after.name)
            && sameOpt(after, before, 'lastSlug') && sameOpt(after, before, 'lastProposalAt')
            && after.lastProposal is string
            && get(proposalDoc(after.lastProposal)).data.get('status', 'pending') != 'approved'
            && getAfter(proposalDoc(after.lastProposal)).data.status == 'approved'
            && getAfter(proposalDoc(after.lastProposal)).data.createdBy == uid)
        );
    }

    match /contributors/{uid} {
      allow read: if true;
      allow create: if verified() && (request.auth.uid == uid || isAdmin())
        && contribOk(uid, {'ratings': 0, 'proposals': 0, 'points': 0}, request.resource.data);
      allow update: if verified() && (request.auth.uid == uid || isAdmin())
        && contribOk(uid, resource.data, request.resource.data);
      allow delete: if false;
    }

    // El sistema anterior (votos "sobrevalorado/justo/infravalorado") queda cerrado.
    match /votes/{id} {
      allow read, write: if false;
    }
  }
}
